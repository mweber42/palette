# Copy this file to .env.local and fill in the two values from your
# Supabase project (Project Settings → API). Both are safe to expose to the
# browser — access is restricted by the Row Level Security policies in
# supabase/schema.sql, not by keeping this key secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
